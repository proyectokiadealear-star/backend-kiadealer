rules_version = '2';

// Toda escritura y lectura de negocio pasa exclusivamente por el backend NestJS
// (Firebase Admin SDK), que no está sujeto a estas reglas. Esta política es la
// defensa contra un cliente que obtenga credenciales de Firebase Auth e intente
// consultar Firestore directo, sin pasar por la API.
//
// Ver docs/design/05-estrategia-de-pruebas.md §5.2 y
// docs/design/02-auditoria.md D-201 — estas reglas no bastan por sí solas para
// garantizar inmutabilidad de auditoría porque el Admin SDK las ignora; la
// garantía real vive en la cadena de hash de audit_logs.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
